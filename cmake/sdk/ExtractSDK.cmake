cmake_minimum_required(VERSION 3.20)
# Untrusted archive entry names and file types are checked before extraction.
foreach(required ARCHIVE DESTINATION VERIFIER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
if(EXISTS "${DESTINATION}" OR IS_SYMLINK "${DESTINATION}")
    message(FATAL_ERROR "Extraction destination must not already exist")
endif()
get_filename_component(parent "${DESTINATION}" DIRECTORY)
get_filename_component(parent "${parent}" ABSOLUTE)
# Reject symlink components rather than following an unexpected destination.
set(ancestor "${parent}")
while(NOT ancestor STREQUAL "")
    if(IS_SYMLINK "${ancestor}")
        message(FATAL_ERROR "Extraction destination has a symlink component")
    endif()
    get_filename_component(next "${ancestor}" DIRECTORY)
    if(next STREQUAL ancestor)
        break()
    endif()
    set(ancestor "${next}")
endwhile()
get_filename_component(filename "${ARCHIVE}" NAME)
if(NOT filename MATCHES "^RFModel-[0-9]+\\.[0-9]+\\.[0-9]+-sdk-headers-g[0-9a-f]+(-developer)?\\.zip$")
    message(FATAL_ERROR "Unsupported SDK archive name")
endif()
string(REGEX REPLACE "\\.zip$" "" root "${filename}")
# Generous fixed engineering-SDK budgets, checked before decompression.
# These checks complement a trusted distribution channel, not a general sandbox.
file(SIZE "${ARCHIVE}" archive_size)
file(SIZE "${ARCHIVE}.sha256" sidecar_size)
if(archive_size GREATER 33554432 OR sidecar_size GREATER 512)
    message(FATAL_ERROR "SDK archive compressed/sidecar size budget exceeded")
endif()
file(READ "${ARCHIVE}.sha256" sidecar LIMIT 512)
file(SHA256 "${ARCHIVE}" digest)
if(NOT sidecar STREQUAL "${digest}  ${filename}\n")
    message(FATAL_ERROR "SDK archive checksum mismatch")
endif()
file(READ "${ARCHIVE}" signature LIMIT 4 HEX)
if(NOT signature STREQUAL "504b0304")
    message(FATAL_ERROR "Expected a ZIP archive")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${ARCHIVE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot list SDK archive: ${error}")
endif()
string(LENGTH "${listing}" listing_size)
if(listing_size GREATER 262144)
    message(FATAL_ERROR "SDK archive listing size budget exceeded")
endif()
string(REPLACE "\r\n" "\n" listing "${listing}")
if(listing MATCHES ";")
    message(FATAL_ERROR "Unsafe archive member name")
endif()
string(REPLACE "\n" ";" members "${listing}")
set(expected "@sdk_payload@;manifest.json")
set(allowed_directories "${root}")
foreach(path IN LISTS expected)
    get_filename_component(directory "${path}" DIRECTORY)
    while(NOT directory STREQUAL "")
        list(APPEND allowed_directories "${root}/${directory}")
        get_filename_component(directory "${directory}" DIRECTORY)
    endwhile()
endforeach()
set(seen)
set(member_count 0)
set(listed_files)
foreach(member IN LISTS members)
    if(member STREQUAL "")
        continue()
    endif()
    math(EXPR member_count "${member_count} + 1")
    string(LENGTH "${member}" name_size)
    if(member_count GREATER 512 OR name_size GREATER 256)
        message(FATAL_ERROR "SDK archive member/name budget exceeded")
    endif()
    string(FIND "${member}" "${root}/" prefix)
    if(NOT member MATCHES "^[A-Za-z0-9_./-]+$" OR member MATCHES "(^|/)\\.\\.?(/|$)" OR
       NOT prefix EQUAL 0 OR member MATCHES "//")
        message(FATAL_ERROR "Unsafe archive member name: ${member}")
    endif()
    string(REGEX REPLACE "/$" "" canonical "${member}")
    if(member MATCHES "/$")
        if(NOT canonical IN_LIST allowed_directories)
            message(FATAL_ERROR "Unexpected archive directory")
        endif()
    else()
        string(LENGTH "${root}/" prefix_length)
        string(SUBSTRING "${member}" ${prefix_length} -1 relative)
        if(NOT relative IN_LIST expected)
            message(FATAL_ERROR "Unexpected archive file")
        endif()
        list(APPEND listed_files "${relative}")
    endif()
    string(TOLOWER "${canonical}" canonical)
    if(canonical IN_LIST seen)
        message(FATAL_ERROR "Duplicate/case-colliding archive member")
    endif()
    list(APPEND seen "${canonical}")
endforeach()
list(SORT listed_files)
list(SORT expected)
if(NOT listed_files STREQUAL expected)
    message(FATAL_ERROR "Archive canonical inventory mismatch")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${ARCHIVE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE verbose ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect SDK archive types: ${error}")
endif()
string(REPLACE "\r\n" "\n" verbose "${verbose}")
string(REPLACE "\n" ";" lines "${verbose}")
set(total_size 0)
set(typed_count 0)
foreach(line IN LISTS lines)
    if(line STREQUAL "")
        continue()
    endif()
    # libarchive's CMake verbose listing: mode, links, owner, group, size, date/name.
    if(NOT line MATCHES "^([-d])[rwxStTs-]+ +[0-9]+ +[^ ]+ +[^ ]+ +([0-9]+) +")
        message(FATAL_ERROR "Archive links or special entries are forbidden; invalid size listing")
    endif()
    set(type "${CMAKE_MATCH_1}")
    set(size "${CMAKE_MATCH_2}")
    string(LENGTH "${size}" digits)
    if(digits GREATER 10)
        message(FATAL_ERROR "SDK archive payload size budget exceeded")
    endif()
    if(size GREATER 8388608 OR (type STREQUAL "d" AND NOT size EQUAL 0))
        message(FATAL_ERROR "SDK archive payload size budget exceeded")
    endif()
    math(EXPR total_size "${total_size} + ${size}")
    math(EXPR typed_count "${typed_count} + 1")
    if(total_size GREATER 67108864 OR typed_count GREATER 512)
        message(FATAL_ERROR "SDK archive total payload size budget exceeded")
    endif()
endforeach()
if(NOT typed_count EQUAL member_count)
    message(FATAL_ERROR "SDK archive listing disagreement")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${DESTINATION}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK_ROOT=${DESTINATION}/${root}" -P "${VERIFIER}"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Extracted SDK validation failed")
endif()
message(STATUS "Extracted verified SDK: ${DESTINATION}/${root}")
