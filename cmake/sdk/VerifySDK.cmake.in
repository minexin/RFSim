cmake_minimum_required(VERSION 3.20)
# This configured inventory is independent of the manifest's self-reported list.
set(expected "@sdk_payload@")
if(NOT DEFINED SDK_ROOT OR NOT IS_DIRECTORY "${SDK_ROOT}" OR IS_SYMLINK "${SDK_ROOT}")
    message(FATAL_ERROR "SDK_ROOT must be a real SDK directory")
endif()
file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${SDK_ROOT}" "${SDK_ROOT}/*")
set(actual)
set(expected_directories)
foreach(path IN LISTS expected)
    get_filename_component(directory "${path}" DIRECTORY)
    while(NOT directory STREQUAL "")
        list(APPEND expected_directories "${directory}")
        get_filename_component(directory "${directory}" DIRECTORY)
    endwhile()
endforeach()
foreach(entry IN LISTS entries)
    if(IS_SYMLINK "${SDK_ROOT}/${entry}")
        message(FATAL_ERROR "SDK symlink rejected: ${entry}")
    endif()
    if(IS_DIRECTORY "${SDK_ROOT}/${entry}")
        if(NOT entry IN_LIST expected_directories)
            message(FATAL_ERROR "SDK unexpected directory: ${entry}")
        endif()
    else()
        list(APPEND actual "${entry}")
    endif()
endforeach()
set(inventory ${expected} manifest.json)
list(SORT inventory)
list(SORT actual)
if(NOT actual STREQUAL inventory)
    message(FATAL_ERROR "SDK inventory mismatch")
endif()
file(READ "${SDK_ROOT}/manifest.json" manifest)
string(JSON schema GET "${manifest}" schema)
string(JSON kind GET "${manifest}" package_kind)
string(JSON version GET "${manifest}" version)
if(NOT schema EQUAL 1 OR NOT kind STREQUAL "header-only-cpp17" OR NOT version STREQUAL "@PROJECT_VERSION@")
    message(FATAL_ERROR "Unsupported SDK manifest")
endif()
string(JSON project GET "${manifest}" project)
string(JSON standard GET "${manifest}" cxx_standard)
string(JSON minimum GET "${manifest}" minimum_cmake)
string(JSON identity GET "${manifest}" identity)
string(JSON dirty_type TYPE "${manifest}" dirty)
string(JSON dirty GET "${manifest}" dirty)
string(JSON commit_type TYPE "${manifest}" source_commit)
string(JSON observed GET "${manifest}" observed_head)
string(JSON epoch GET "${manifest}" commit_epoch)
string(LENGTH "${observed}" head_length)
if(NOT project STREQUAL "RFModel" OR NOT standard EQUAL 17 OR NOT minimum STREQUAL "3.20" OR
    NOT dirty_type STREQUAL "BOOLEAN" OR NOT observed MATCHES "^[0-9a-f]+$" OR
    NOT (head_length EQUAL 40 OR head_length EQUAL 64) OR NOT epoch MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid SDK identity metadata")
endif()
if(dirty)
    if(NOT identity STREQUAL "developer-worktree-no-exact-commit" OR NOT commit_type STREQUAL "NULL")
        message(FATAL_ERROR "Invalid developer SDK identity")
    endif()
else()
    string(JSON commit GET "${manifest}" source_commit)
    if(NOT identity STREQUAL "exact-clean-commit" OR NOT commit_type STREQUAL "STRING" OR NOT commit STREQUAL observed)
        message(FATAL_ERROR "Invalid clean SDK identity")
    endif()
endif()
string(JSON count LENGTH "${manifest}" files)
list(LENGTH expected wanted)
if(NOT count EQUAL wanted)
    message(FATAL_ERROR "SDK manifest file count mismatch")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    list(GET expected ${index} expected_path)
    string(JSON path GET "${manifest}" files ${index} path)
    if(NOT path STREQUAL expected_path)
        message(FATAL_ERROR "SDK manifest path/order mismatch")
    endif()
    string(JSON hash GET "${manifest}" files ${index} sha256)
    string(JSON size GET "${manifest}" files ${index} size)
    file(SHA256 "${SDK_ROOT}/${path}" actual_hash)
    file(SIZE "${SDK_ROOT}/${path}" actual_size)
    if(NOT hash STREQUAL actual_hash OR NOT size EQUAL actual_size)
        message(FATAL_ERROR "SDK payload hash/size mismatch: ${path}")
    endif()
endforeach()
message(STATUS "Verified SDK inventory and payload hashes")
