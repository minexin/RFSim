cmake_minimum_required(VERSION 3.20)
set(source "@CMAKE_CURRENT_SOURCE_DIR@")
set(binary "@CMAKE_CURRENT_BINARY_DIR@")
set(git "@GIT_EXECUTABLE@")
set(inputs "@sdk_inputs@")
set(input_hashes "@sdk_input_hashes@")
set(payload "@sdk_payload@")
if(NOT DEFINED OUTPUT_DIRECTORY)
    set(OUTPUT_DIRECTORY "${binary}/sdk-artifacts")
endif()
get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_DIRECTORY}" ABSOLUTE)
if(NOT DEFINED CONFIG)
    set(CONFIG "@CMAKE_BUILD_TYPE@")
endif()
if(NOT CONFIG MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "CONFIG must name a standard build configuration")
endif()
function(git_read output)
    execute_process(COMMAND "${git}" -C "${source}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot establish SDK Git identity: ${error}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(check_source)
    git_read(toplevel rev-parse --show-toplevel)
    file(REAL_PATH "${source}" real_source)
    file(REAL_PATH "${toplevel}" real_top)
    if(NOT real_source STREQUAL real_top)
        message(FATAL_ERROR "SDK source must be the actual Git worktree root")
    endif()
    git_read(head rev-parse --verify HEAD)
    if(NOT head MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid Git revision")
    endif()
    string(LENGTH "${head}" head_length)
    if(NOT head_length EQUAL 40 AND NOT head_length EQUAL 64)
        message(FATAL_ERROR "Invalid Git revision length")
    endif()
    git_read(state status --porcelain=v1 --untracked-files=all)
    git_read(flags ls-files -v)
    if(flags MATCHES "(^|\n)[a-zS] ")
        message(FATAL_ERROR "Hidden Git index flags prevent exact cleanliness validation")
    endif()
    set(dirty false)
    if(NOT state STREQUAL "")
        set(dirty true)
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        list(GET inputs ${index} path)
        list(GET input_hashes ${index} expected)
        if(IS_SYMLINK "${source}/${path}" OR NOT EXISTS "${source}/${path}")
            message(FATAL_ERROR "SDK input missing or symlink: ${path}")
        endif()
        file(SHA256 "${source}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "SDK source changed after configuration; reconfigure: ${path}")
        endif()
        # Explicitly test deliverable inputs, including ignored/untracked files.
        execute_process(COMMAND "${git}" -C "${source}" rev-parse "HEAD:${path}"
            RESULT_VARIABLE tracked OUTPUT_VARIABLE committed OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET)
        git_read(blob hash-object -- "${path}")
        if(NOT tracked EQUAL 0 OR NOT committed STREQUAL blob)
            set(dirty true)
        endif()
    endforeach()
    if(dirty AND NOT ALLOW_DIRTY_DEVELOPER)
        message(FATAL_ERROR "SDK candidate requires a clean Git worktree; explicit ALLOW_DIRTY_DEVELOPER=ON permits a non-release developer archive")
    endif()
    set(head "${head}" PARENT_SCOPE)
    set(dirty "${dirty}" PARENT_SCOPE)
    set(state "${state}" PARENT_SCOPE)
endfunction()
check_source()
set(initial_head "${head}")
set(initial_state "${state}")
set(initial_dirty "${dirty}")
git_read(commit_epoch show -s --format=%ct HEAD)
if(NOT commit_epoch MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid commit timestamp")
endif()
string(SUBSTRING "${head}" 0 12 short)
set(name "RFModel-@PROJECT_VERSION@-sdk-headers-g${short}")
set(source_commit "\"${head}\"")
set(identity "exact-clean-commit")
if(dirty)
    string(APPEND name "-developer")
    set(source_commit null)
    set(identity "developer-worktree-no-exact-commit")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
if(EXISTS "${OUTPUT_DIRECTORY}/${name}.zip" OR EXISTS "${OUTPUT_DIRECTORY}/${name}.zip.sha256")
    message(FATAL_ERROR "SDK output already exists; choose a fresh output directory")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(stage "${OUTPUT_DIRECTORY}/stage-${nonce}")
if(EXISTS "${stage}")
    message(FATAL_ERROR "SDK staging collision")
endif()
set(root "${stage}/${name}")
# Re-derive generated exports and wrappers from checked source. A modified caller
# build cache/install script must never contaminate an exact-commit candidate.
set(fresh "${stage}/sdk-build")
set(generator_options)
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND generator_options -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
    list(APPEND generator_options -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${fresh}" ${generator_options}
    -G "@CMAKE_GENERATOR@" "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_BUILD_TYPE=${CONFIG}" -DCMAKE_INSTALL_LIBDIR=lib
    -DBUILD_TESTING=OFF -DRFMODEL_BUILD_C_API=OFF -DRFMODEL_BUILD_CLI=OFF
    -DRFMODEL_BUILD_EXAMPLES=OFF -DRFMODEL_ENABLE_SDK_PACKAGING=ON
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fresh SDK configuration failed")
endif()
include("${fresh}/SDKProducer.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${fresh}" --config "${CONFIG}" --prefix "${root}"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "SDK install failed")
endif()
file(COPY "${source}/examples/sdk-consumer" DESTINATION "${root}/examples"
    FILES_MATCHING PATTERN "CMakeLists.txt" PATTERN "*.cpp" PATTERN "README.md")
configure_file("${source}/cmake/sdk/README.md" "${root}/README.md" COPYONLY)
configure_file("${fresh}/VerifySDK.cmake" "${root}/verify-sdk.cmake" COPYONLY)
# All exported files are text. Reject accidental source/build/staging path leaks.
foreach(path IN LISTS payload)
    if(IS_SYMLINK "${root}/${path}" OR NOT EXISTS "${root}/${path}")
        message(FATAL_ERROR "Invalid installed SDK file: ${path}")
    endif()
    file(READ "${root}/${path}" content)
    foreach(forbidden "${source}" "${binary}" "${stage}" "${fresh}")
        string(FIND "${content}" "${forbidden}" found)
        if(NOT found EQUAL -1)
            message(FATAL_ERROR "SDK path leak: ${path}")
        endif()
    endforeach()
endforeach()
# Source/header and compatibility wrapper contents must match this configuration.
foreach(header IN ITEMS @RFMODEL_PUBLIC_HEADERS@)
    file(SHA256 "${source}/include/rfmodel/${header}" source_hash)
    file(SHA256 "${root}/include/rfmodel/${header}" installed_hash)
    if(NOT source_hash STREQUAL installed_hash)
        message(FATAL_ERROR "Installed header differs from source: ${header}")
    endif()
    get_filename_component(flat "${header}" NAME)
    file(READ "${root}/include/rfmodel/${flat}" wrapper)
    if(NOT wrapper STREQUAL "#pragma once\n// Compatibility include. Prefer the module-qualified path in new code.\n#include <rfmodel/${header}>\n")
        message(FATAL_ERROR "Invalid compatibility wrapper: ${flat}")
    endif()
endforeach()
string(TIMESTAMP generated "%Y-%m-%dT%H:%M:%SZ" UTC)
set(manifest "{\n  \"schema\": 1,\n  \"project\": \"RFModel\",\n  \"version\": \"@PROJECT_VERSION@\",\n  \"package_kind\": \"header-only-cpp17\",\n  \"cxx_standard\": 17,\n  \"minimum_cmake\": \"3.20\",\n  \"identity\": \"${identity}\",\n  \"source_commit\": ${source_commit},\n  \"observed_head\": \"${head}\",\n  \"dirty\": ${dirty},\n  \"commit_epoch\": ${commit_epoch},\n  \"generated_utc\": \"${generated}\",\n  \"producer\": {\"os\": \"${sdk_producer_os}\", \"compiler\": \"${sdk_producer_compiler}\", \"cmake\": \"${sdk_producer_cmake}\", \"configuration\": \"${CONFIG}\"},\n  \"files\": [")
set(separator "")
foreach(path IN LISTS payload)
    file(SHA256 "${root}/${path}" hash)
    file(SIZE "${root}/${path}" size)
    string(APPEND manifest "${separator}\n    {\"path\": \"${path}\", \"size\": ${size}, \"sha256\": \"${hash}\"}")
    set(separator ",")
endforeach()
string(APPEND manifest "\n  ]\n}\n")
file(WRITE "${root}/manifest.json" "${manifest}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${fresh}/VerifySDK.cmake"
    RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Staged SDK verification failed")
endif()
check_source()
if(NOT head STREQUAL initial_head OR NOT state STREQUAL initial_state OR NOT dirty STREQUAL initial_dirty)
    message(FATAL_ERROR "Git identity changed while packaging")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT_DIRECTORY}/${name}.zip" --format=zip "${name}"
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "SDK ZIP creation failed")
endif()
file(SHA256 "${OUTPUT_DIRECTORY}/${name}.zip" checksum)
file(WRITE "${OUTPUT_DIRECTORY}/${name}.zip.sha256" "${checksum}  ${name}.zip\n")
message(STATUS "Created ${OUTPUT_DIRECTORY}/${name}.zip (${identity})")
