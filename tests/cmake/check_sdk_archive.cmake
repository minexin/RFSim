cmake_minimum_required(VERSION 3.20)
foreach(required SOURCE BINARY GENERATOR COMPILER)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
find_package(Git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(work "${BINARY}/run-${nonce}")
set(fixture "${work}/source")
file(MAKE_DIRECTORY "${fixture}/examples")
file(COPY "${SOURCE}/CMakeLists.txt" "${SOURCE}/include" "${SOURCE}/cmake" "${SOURCE}/src" DESTINATION "${fixture}")
file(COPY "${SOURCE}/examples/sdk-consumer" DESTINATION "${fixture}/examples")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed (${status}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
function(reject reason)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT "${output}\n${error}" MATCHES "${reason}")
        message(FATAL_ERROR "Expected failure (${reason}): ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
run("${GIT_EXECUTABLE}" -C "${fixture}" init -q)
run("${GIT_EXECUTABLE}" -C "${fixture}" add .)
# Identity exists only for this disposable fixture; no global/user Git config.
run("${GIT_EXECUTABLE}" -C "${fixture}" -c user.name=SDK-test-fixture
    -c user.email=sdk-fixture@example.invalid commit -q -m "SDK test fixture")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${fixture}" rev-parse HEAD
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(build "${work}/build")
set(options -G "${GENERATOR}" "-DCMAKE_CXX_COMPILER=${COMPILER}"
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF
    -DRFMODEL_BUILD_C_API=OFF -DRFMODEL_BUILD_CLI=OFF -DRFMODEL_BUILD_EXAMPLES=OFF
    -DRFMODEL_ENABLE_SDK_PACKAGING=ON)
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${build}" ${options})
# Poison stale generated files; packaging must re-derive, not consume them.
file(READ "${build}/VerifySDK.cmake" pristine_verifier)
file(APPEND "${build}/cmake_install.cmake" "\nmessage(FATAL_ERROR \"STALE INSTALL USED\")\n")
file(APPEND "${build}/VerifySDK.cmake" "\nmessage(FATAL_ERROR \"STALE VERIFIER USED\")\n")
file(APPEND "${build}/RFModelConfig.cmake" "\nmessage(FATAL_ERROR \"STALE EXPORT USED\")\n")
file(APPEND "${build}/legacy-include/rfmodel/device_model.hpp" "\n#error stale wrapper\n")
run("${CMAKE_COMMAND}" -P "${build}/PackageSDK.cmake")
file(WRITE "${build}/VerifySDK.cmake" "${pristine_verifier}")
file(GLOB archives "${build}/sdk-artifacts/*.zip")
list(LENGTH archives count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one clean SDK archive")
endif()
list(GET archives 0 archive)
get_filename_component(name "${archive}" NAME)
string(REGEX REPLACE "\\.zip$" "" name "${name}")
set(extraction "${work}/extracted SDK with spaces")
set(root "${extraction}/${name}")
set(verifier "${build}/VerifySDK.cmake")
set(extractor "${build}/ExtractSDK.cmake")
run("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DDESTINATION=${extraction}"
    "-DVERIFIER=${verifier}" -P "${extractor}")
file(READ "${root}/manifest.json" manifest)
string(JSON identity GET "${manifest}" identity)
string(JSON commit GET "${manifest}" source_commit)
string(JSON dirty GET "${manifest}" dirty)
if(NOT identity STREQUAL "exact-clean-commit" OR NOT commit STREQUAL head OR dirty)
    message(FATAL_ERROR "Clean SDK identity does not match actual fixture HEAD")
endif()
# Validate a synthetic pointer-size mismatch without requiring a cross compiler.
file(WRITE "${work}/arch.cmake" "cmake_minimum_required(VERSION 3.20)\nset(CMAKE_SIZEOF_VOID_P 123)\nset(PACKAGE_FIND_VERSION 0.1.0)\ninclude(\"${root}/lib/cmake/RFModel/RFModelConfigVersion.cmake\")\nif(PACKAGE_VERSION_UNSUITABLE OR NOT PACKAGE_VERSION_EXACT)\n message(FATAL_ERROR \"Pure SDK rejected architecture mismatch\")\nendif()\n")
run("${CMAKE_COMMAND}" -P "${work}/arch.cmake")
file(MAKE_DIRECTORY "${work}/wrong-version")
file(WRITE "${work}/wrong-version/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)\nproject(WrongVersion LANGUAGES NONE)\nfind_package(RFModel 9.9.9 EXACT CONFIG REQUIRED NO_DEFAULT_PATH PATHS \"${root}/lib/cmake/RFModel\")\n")
reject("exactly[\r\n ]+matches requested version" "${CMAKE_COMMAND}" -S "${work}/wrong-version" -B "${work}/wrong-version-build")
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${work}/c-api-version" ${options}
    -DRFMODEL_ENABLE_SDK_PACKAGING=OFF -DRFMODEL_BUILD_C_API=ON)
file(WRITE "${work}/c-api-arch.cmake" "cmake_minimum_required(VERSION 3.20)\nset(CMAKE_SIZEOF_VOID_P 123)\nset(PACKAGE_FIND_VERSION 0.1.0)\ninclude(\"${work}/c-api-version/RFModelConfigVersion.cmake\")\nif(NOT PACKAGE_VERSION_UNSUITABLE)\n message(FATAL_ERROR \"C ABI architecture mismatch not rejected\")\nendif()\n")
run("${CMAKE_COMMAND}" -P "${work}/c-api-arch.cmake")
reject("SDK packaging requires" "${CMAKE_COMMAND}" -S "${fixture}" -B "${work}/c-api-package" ${options} -DRFMODEL_BUILD_C_API=ON)
# Use the packaged standalone example, with package registries disabled.
run("${CMAKE_COMMAND}" -S "${root}/examples/sdk-consumer" -B "${work}/example-build"
    -G "${GENERATOR}" "-DCMAKE_CXX_COMPILER=${COMPILER}" -DCMAKE_BUILD_TYPE=Release
    "-DRFModel_DIR=${root}/lib/cmake/RFModel"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
run("${CMAKE_COMMAND}" --build "${work}/example-build" --config Release --parallel 2)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
run("${cmake_bin}/ctest" --test-dir "${work}/example-build" -C Release --output-on-failure)
file(READ "${root}/README.md" readme)
file(APPEND "${root}/README.md" "tampered\n")
reject("payload hash/size mismatch" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
file(WRITE "${root}/README.md" "${readme}")
file(RENAME "${root}/README.md" "${root}/missing.md")
reject("inventory mismatch" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
file(RENAME "${root}/missing.md" "${root}/README.md")
file(WRITE "${root}/extra.txt" "not allowlisted")
reject("inventory mismatch" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
file(REMOVE "${root}/extra.txt")
string(REPLACE "README.md" "../README.md" bad_manifest "${manifest}")
file(WRITE "${root}/manifest.json" "${bad_manifest}")
reject("path/order mismatch" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
file(WRITE "${root}/manifest.json" "${manifest}")
string(JSON bad_identity SET "${manifest}" dirty true)
file(WRITE "${root}/manifest.json" "${bad_identity}")
reject("Invalid developer SDK identity" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
file(WRITE "${root}/manifest.json" "${manifest}")
reject("must not already exist" "${CMAKE_COMMAND}" "-DARCHIVE=${archive}"
    "-DDESTINATION=${extraction}" "-DVERIFIER=${verifier}" -P "${extractor}")
file(READ "${archive}.sha256" sidecar)
file(APPEND "${archive}.sha256" "bad")
reject("checksum mismatch" "${CMAKE_COMMAND}" "-DARCHIVE=${archive}"
    "-DDESTINATION=${work}/checksum-failure" "-DVERIFIER=${verifier}" -P "${extractor}")
file(WRITE "${archive}.sha256" "${sidecar}")
# A new checksum cannot make traversal members safe. Check before any extraction.
file(MAKE_DIRECTORY "${work}/malicious/sub")
file(WRITE "${work}/malicious/escape" "containment sentinel")
set(bad "${work}/malicious/${name}.zip")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${bad}" --format=zip ../escape
    WORKING_DIRECTORY "${work}/malicious/sub" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${bad}" hash)
file(WRITE "${bad}.sha256" "${hash}  ${name}.zip\n")
reject("Unsafe archive member name" "${CMAKE_COMMAND}" "-DARCHIVE=${bad}"
    "-DDESTINATION=${work}/traversal-failure" "-DVERIFIER=${verifier}" -P "${extractor}")
if(EXISTS "${work}/traversal-failure")
    message(FATAL_ERROR "Unsafe archive created an extraction destination")
endif()
file(READ "${work}/malicious/escape" sentinel)
if(NOT sentinel STREQUAL "containment sentinel")
    message(FATAL_ERROR "Traversal containment sentinel changed")
endif()
# Duplicate entries and links are also rejected before extraction.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${bad}" --format=zip "${name}" "${name}"
    WORKING_DIRECTORY "${extraction}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${bad}" hash)
file(WRITE "${bad}.sha256" "${hash}  ${name}.zip\n")
reject("Duplicate/case-colliding" "${CMAKE_COMMAND}" "-DARCHIVE=${bad}"
    "-DDESTINATION=${work}/duplicate-failure" "-DVERIFIER=${verifier}" -P "${extractor}")
# Windows may lack symlink privileges. This is explicit; Unix always tests links.
file(RENAME "${root}/README.md" "${work}/saved-readme")
execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink "${work}/saved-readme" "${root}/README.md"
    RESULT_VARIABLE link_status ERROR_VARIABLE link_error)
if(link_status EQUAL 0)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${bad}" --format=zip "${name}"
        WORKING_DIRECTORY "${extraction}" COMMAND_ERROR_IS_FATAL ANY)
    file(SHA256 "${bad}" hash)
    file(WRITE "${bad}.sha256" "${hash}  ${name}.zip\n")
    reject("links or special entries" "${CMAKE_COMMAND}" "-DARCHIVE=${bad}"
        "-DDESTINATION=${work}/link-failure" "-DVERIFIER=${verifier}" -P "${extractor}")
    reject("symlink rejected" "${CMAKE_COMMAND}" "-DSDK_ROOT=${root}" -P "${verifier}")
    file(REMOVE "${root}/README.md")
elseif(UNIX)
    message(FATAL_ERROR "Cannot create required symlink fixture: ${link_error}")
else()
    message(STATUS "Symlink fixture unavailable on this host: ${link_error}")
endif()
file(RENAME "${work}/saved-readme" "${root}/README.md")
# Highly compressible oversized allowlisted data must fail before decompression.
file(READ "${root}/README.md" original_readme)
string(REPEAT "A" 8388609 oversized_readme)
file(WRITE "${root}/README.md" "${oversized_readme}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${bad}" --format=zip "${name}"
    WORKING_DIRECTORY "${extraction}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${bad}" hash)
file(WRITE "${bad}.sha256" "${hash}  ${name}.zip\n")
reject("payload size budget exceeded" "${CMAKE_COMMAND}" "-DARCHIVE=${bad}"
    "-DDESTINATION=${work}/oversized-failure" "-DVERIFIER=${verifier}" -P "${extractor}")
if(EXISTS "${work}/oversized-failure")
    message(FATAL_ERROR "Oversized payload was extracted")
endif()
file(WRITE "${root}/README.md" "${original_readme}")
string(REPEAT "A" 513 oversized_sidecar)
file(WRITE "${bad}.sha256" "${oversized_sidecar}")
reject("compressed/sidecar size budget exceeded" "${CMAKE_COMMAND}" "-DARCHIVE=${bad}"
    "-DDESTINATION=${work}/oversized-sidecar" "-DVERIFIER=${verifier}" -P "${extractor}")
# Source changes, ignored/untracked inputs and a dirty developer archive are honest.
file(APPEND "${fixture}/examples/sdk-consumer/README.md" "\nFixture dirty change.\n")
reject("source changed after configuration" "${CMAKE_COMMAND}" "-DOUTPUT_DIRECTORY=${work}/stale" -P "${build}/PackageSDK.cmake")
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${build}" ${options})
reject("requires a clean Git worktree" "${CMAKE_COMMAND}" "-DOUTPUT_DIRECTORY=${work}/dirty-rejected" -P "${build}/PackageSDK.cmake")
run("${CMAKE_COMMAND}" -DALLOW_DIRTY_DEVELOPER=ON "-DOUTPUT_DIRECTORY=${work}/developer" -P "${build}/PackageSDK.cmake")
file(GLOB manifests "${work}/developer/stage-*/*/manifest.json")
list(GET manifests 0 developer_manifest)
file(READ "${developer_manifest}" developer)
string(JSON identity GET "${developer}" identity)
string(JSON commit_type TYPE "${developer}" source_commit)
string(JSON observed GET "${developer}" observed_head)
string(JSON dirty GET "${developer}" dirty)
if(NOT identity STREQUAL "developer-worktree-no-exact-commit" OR NOT commit_type STREQUAL "NULL" OR
    NOT observed STREQUAL head OR NOT dirty)
    message(FATAL_ERROR "Developer SDK makes an incorrect exact-commit claim")
endif()
run("${GIT_EXECUTABLE}" -C "${fixture}" restore examples/sdk-consumer/README.md)
run("${CMAKE_COMMAND}" -S "${fixture}" -B "${build}" ${options})
file(WRITE "${fixture}/untracked.txt" "untracked fixture")
reject("requires a clean Git worktree" "${CMAKE_COMMAND}" "-DOUTPUT_DIRECTORY=${work}/untracked" -P "${build}/PackageSDK.cmake")
message(STATUS "SDK archive identity, inventory, integrity, containment, version and example checks passed")
