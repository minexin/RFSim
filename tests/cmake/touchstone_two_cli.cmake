if(NOT DEFINED CLI)
    message(FATAL_ERROR "CLI executable required")
endif()
set(root "${CMAKE_CURRENT_BINARY_DIR}/touchstone-two-cli")
file(MAKE_DIRECTORY "${root}")
set(prefix "[Version] 2.0\n# Hz S RI R 50\n[Number of Ports] 2\n[Two-Port Data Order] 12_21\n[Number of Frequencies] 1\n")
file(WRITE "${root}/unequal.ts" "${prefix}[Reference] 31 73\n[Network Data]\n1 0 0 1 0 1 0 0 0\n[End]\n")
execute_process(COMMAND "${CLI}" "${root}/unequal.ts" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT output STREQUAL "" OR NOT error MATCHES "common Touchstone reference")
    message(FATAL_ERROR "unequal-reference CLI must fail before output: ${result}, ${output}, ${error}")
endif()
file(WRITE "${root}/common.ts" "${prefix}[Reference] 75 75\n[Network Data]\n1 0 0 1 0 1 0 0 0\n[End]\n")
execute_process(COMMAND "${CLI}" "${root}/common.ts" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "1,1,2,75,1,0")
    message(FATAL_ERROR "common-reference CLI must use [Reference]: ${result}, ${output}, ${error}")
endif()
