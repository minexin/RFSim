# Copied dual-TU example against full/pure relocated SDKs, never source includes.
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "MNA noise installed check failed (${status}): ${ARGV}\n${output}\n${error}")
    endif()
    message(STATUS "MNA noise installed check passed: ${ARGV}\n${output}")
endfunction()
if(NOT CONFIG)
    set(CONFIG Release)
endif()
if(NOT DEFINED MODES)
    set(MODES full pure)
endif()
foreach(mode IN LISTS MODES)
    if(NOT mode STREQUAL "full" AND NOT mode STREQUAL "pure")
        message(FATAL_ERROR "Unknown SDK mode: ${mode}")
    endif()
    set(c_api ON)
    if(mode STREQUAL "pure")
        set(c_api OFF)
    endif()
    set(root "${BINARY}/${mode}")
    run("${CMAKE_COMMAND}" -S "${SOURCE}" -B "${root}/producer" -G "${GENERATOR}"
        "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
        -DCMAKE_CXX_EXTENSIONS=OFF -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF
        "-DRFMODEL_BUILD_C_API=${c_api}" "-DRFMODEL_BUILD_CLI=${c_api}"
        -DRFMODEL_BUILD_EXAMPLES=OFF -DRFMODEL_BUILD_REFERENCE_TESTS=OFF)
    run("${CMAKE_COMMAND}" --build "${root}/producer" --config "${CONFIG}" --parallel 2)
    run("${CMAKE_COMMAND}" --install "${root}/producer" --config "${CONFIG}" --prefix "${root}/original SDK")
    file(REMOVE_RECURSE "${root}/relocated SDK")
    file(RENAME "${root}/original SDK" "${root}/relocated SDK")
    file(READ "${root}/producer/CMakeCache.txt" cache)
    if(cache MATCHES "Python3_EXECUTABLE" OR (mode STREQUAL "pure" AND cache MATCHES "CMAKE_C_COMPILER:"))
        message(FATAL_ERROR "SDK unexpectedly enabled Python or pure-mode C")
    endif()
    if(NOT EXISTS "${root}/relocated SDK/lib/cmake/RFModel/RFModelConfig.cmake")
        message(FATAL_ERROR "Relocated RFModel package is missing")
    endif()
    file(COPY "${SOURCE}/examples/mna-noise-sdk/" DESTINATION "${root}/copied consumer")
    run("${CMAKE_COMMAND}" -S "${root}/copied consumer" -B "${root}/consumer build" -G "${GENERATOR}"
        "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
        "-DRFModel_DIR=${root}/relocated SDK/lib/cmake/RFModel"
        -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
    file(READ "${root}/consumer build/CMakeCache.txt" consumer_cache)
    if(consumer_cache MATCHES "CMAKE_C_COMPILER:|Python3_EXECUTABLE")
        message(FATAL_ERROR "Installed example unexpectedly enabled C or Python")
    endif()
    run("${CMAKE_COMMAND}" --build "${root}/consumer build" --config "${CONFIG}" --parallel 2)
    run("${CMAKE_CTEST_COMMAND}" --test-dir "${root}/consumer build" -C "${CONFIG}" --parallel 1 --verbose)
endforeach()
