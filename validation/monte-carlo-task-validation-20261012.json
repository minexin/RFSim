{
  "schema_version": 1,
  "date": "2026-10-12",
  "stage": "A09 declarative Monte Carlo tasks with shared system parameter bindings",
  "base_commit": "54d5dc08d6e73796e6b10502fba45345a8376399",
  "implementation": [
    "Versioned JSON Monte Carlo task/result and CLI dispatch across nine existing analysis formats",
    "Six native distributions with named task parameters, uint64 seed and complete input/options snapshots",
    "Existing numeric-leaf affine bindings, unique selectors and shared parameters across multiple destinations",
    "Exact integer discrete mappings, per-sample validation for unbounded distributions and no hidden clipping",
    "Multi-metric real/complex projections, native joint limits, statistics and explicit pass denominators",
    "Analysis invocation counts distinct from evaluator and sampling counts; no export-time reanalysis",
    "Common path/measurement/fingerprint helpers extracted unchanged from optimization tasks",
    "Touchstone before/after hashes, strict finite JSON input and CLI hard-link overwrite protection"
  ],
  "independent_checks": [
    "4096 resistor tolerance samples checked against closed-form transmission/reflection",
    "1024 coherent image-rejection phase samples checked against independent sine/cosine physical response",
    "Sample mean, variance, deviation, standard error and type-7 quantiles independently recomputed",
    "Preset six-population-standard-error consistency checks for mean and pass probability",
    "All six task distributions reproduce direct native API parameter streams",
    "All nine existing analysis formats exercised as fixed two-attempt tasks",
    "Shared anticorrelated device bindings, exact integer frequency bins and complex metric projections",
    "Sampling/binding/analysis/measurement failure counts, cancellation, fatal errors and history-independent results",
    "Input freezing, duplicate/canonical paths, invalid schemas and full-width seed round trip",
    "CLI protects model/Touchstone hardlinks and retains existing output on invalid tasks",
    "Original optimization task suite still passes after helper extraction"
  ],
