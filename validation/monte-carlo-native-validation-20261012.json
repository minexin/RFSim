{
  "schema_version": 1,
  "date": "2026-10-12",
  "stage": "A09 native Monte Carlo tolerance analysis and stable statistics",
  "base_commit": "b0a715826d331aedf465aa298ffb60d5d27d49b6",
  "implementation": [
    "Six independent distributions with explicit MT19937-64 random word mapping and seed",
    "Attempt budget, failure stop/reject, cancellation and optional replayable history",
    "Distinct sampling/evaluation/valid/rejected counters and two explicitly defined pass fractions",
    "Centered and scaled two-pass statistics, optional unrepresentable statistics and type-7 quantiles",
    "Complete RF resistor tolerance example with analytic per-sample, population and pass references"
  ],
  "independent_checks": [
    "Standard MT19937-64 10000th output golden constant through public uniform sampling",
    "Six distribution analytic moments with 50000 samples and discrete uniform histogram",
    "Known exact quantiles/sample variance, large offset adjacent ULP variance and extreme finite values",
    "Same-environment byte replay, recording-independent streams and frozen request copies",
    "Failure, nonfinite output, incorrect dimensions, fatal exceptions, cancellation and invalid requests",
    "Every RF trace point checked against resistor circuit closed form and Python statistics",
    "Declared six-standard-error mean/pass tolerances and DKW quantile probability envelope"
  ],
