{
  "schema_version": 1,
  "date": "2026-10-12",
  "stage": "A09 declarative optimization tasks and system parameter binding",
  "base_commit": "0dc3bc4e4e6cc9ec3d3cd76b2906bd1d776a0340",
  "implementation": [
    "Versioned optimization task and result formats, CLI dispatch and Python API",
    "Existing nine analysis formats reused without a second numerical implementation",
    "Real/log/integer parameters, affine multi-leaf bindings and unique result selectors",
    "Weighted minimize/maximize/target/upper/lower goals and explicit complex measurements",
    "Native evaluation budget includes failures; best model and analysis snapshots never rerun",
    "Touchstone before/after hashes and output protection including hard-link aliases"
  ],
  "independent_checks": [
    "LC optimum and every evaluation checked against independent impedance equation",
    "Image rejection phase optimum and every evaluation checked against independent sine response",
    "All nine existing analysis formats exercised as one-evaluation tasks",
    "Exact integer multiple bindings, all objective formulas and complex projections",
    "Template immutability, canonical overlapping path rejection, finite mapping range and unique selectors",
    "No hidden extra analyses on export, history-disabled budget snapshot and cancellation",
    "Invalid-candidate stop/reject policies, missing result paths and undefined zero-amplitude dB",
    "CLI input/hard-link protection, failure preserves output and changed dependency rejects result"
  ],
