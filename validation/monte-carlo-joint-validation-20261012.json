{
  "schema_version": 1,
  "date": "2026-10-12",
  "stage": "A09 native Gaussian copula and accepted-row joint statistics",
  "base_commit": "9dc33facc959104f0a02da600d26f29c40c0477f",
  "implementation": [
    "Optional latent Gaussian correlation for all six existing marginal distributions",
    "Deterministic pivoted PSD Cholesky with observable effective matrix and rank",
    "Legacy independent stream preserved when matrix is empty",
    "Fixed complete-vector random budget in correlated mode; no hidden retry or tail clipping",
    "Optional accepted-row parameter and metric covariance/correlation with independent representability",
    "Joint moments computed before marginal sorting; robust scaled cross products",
    "Installed C++ consumer and correlated resistor network example"
  ],
  "independent_checks": [
    "Hand-calculated paired covariance with unsorted observations",
    "Pivoted rank-two basis relations and rank-one mixed marginal transforms",
    "Positive and negative perfect dependence; 64-dimensional singular PSD",
    "Normal, lognormal and uniform population dependence checks",
    "Overflow/underflow joint statistics and constant/unavailable entries",
    "Sampling/evaluation failure alignment, cancellation, frozen request and replay",
    "4096 actual RF solves checked against closed-form transmission/reflection/resistance",
    "Independent Python recomputation of all sample joint moments and quantiles",
    "Preset six-standard-error population mean/variance/covariance/pass checks"
  ],
